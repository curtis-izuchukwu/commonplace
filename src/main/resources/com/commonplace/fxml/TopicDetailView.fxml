<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.commonplace.ui.controller.TopicDetailController"
      spacing="18"
      styleClass="app-root,topic-detail-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="topicNameLabel" text="Topic" styleClass="page-title"/>
            <Label fx:id="moduleNameLabel"
                   text="Parent module"
                   styleClass="app-subtitle"
                   wrapText="true"/>
        </VBox>

        <Button text="Close" onAction="#handleClose" styleClass="primary-button"/>
    </HBox>

    <VBox spacing="10" styleClass="topic-mastery-card">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="MASTERY ESTIMATE" styleClass="section-eyebrow"/>
                <Label fx:id="masteryLabel" text="Limited evidence" styleClass="mastery-caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="masteryValueLabel" text="0%" styleClass="mastery-value"/>
        </HBox>
        <ProgressBar fx:id="masteryProgressBar" maxWidth="Infinity"/>
        <TitledPane fx:id="evidencePane"
                    text="View supporting evidence"
                    expanded="false"
                    styleClass="evidence-pane">
            <content>
                <VBox fx:id="learningEvidenceBox" spacing="12" styleClass="evidence-content"/>
            </content>
        </TitledPane>
    </VBox>

    <FlowPane fx:id="topicMetaBox"
              hgap="8"
              vgap="8"
              styleClass="record-stat-grid"/>
    <Label fx:id="descriptionLabel"
           text="Description"
           wrapText="true"
           styleClass="topic-description"/>

    <Separator/>

    <HBox spacing="12">
        <Label text="Worksheets" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Import from PDF (Beta)"
                onAction="#handleImportWorksheet"/>
        <Button text="Add Worksheet"
                onAction="#handleAddWorksheet"
                styleClass="primary-button"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="worksheetsList" spacing="10"/>
        </content>
    </ScrollPane>

    <Label fx:id="statusLabel" text="" styleClass="status-text"/>
</VBox>
