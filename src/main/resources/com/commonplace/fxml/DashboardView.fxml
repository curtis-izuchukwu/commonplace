<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.commonplace.ui.controller.DashboardController"
           styleClass="app-root">

    <BorderPane>
        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar,dashboard-top-bar">
                <VBox spacing="3" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel"
                           text="Welcome Back"
                           styleClass="app-title,page-title" wrapText="true"/>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="dashboard-nav">
                    <Button fx:id="dashboardButton"
                            text="Dashboard"
                            styleClass="nav-button"
                            onAction="#handleOpenDashboard"/>

                    <Button text="Manage Modules"
                            fx:id="manageModulesButton"
                            styleClass="nav-button"
                            onAction="#handleOpenModules"/>

                    <Button text="Mistake Bank"
                            styleClass="nav-button"
                            onAction="#handleOpenMistakeBank"/>

                    <MenuButton fx:id="accountMenuButton"
                                text=""
                                styleClass="account-menu-button">
                        <items>
                            <MenuItem fx:id="accountNameItem" text="Signed in"/>
                            <MenuItem text="Settings" onAction="#handleOpenSettings"/>
                            <MenuItem text="Change Password" onAction="#handleChangePassword"/>
                            <MenuItem text="Switch Account" onAction="#handleSwitchAccount"/>
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </top>

        <center>
            <StackPane fx:id="contentHost">
                <ScrollPane fx:id="dashboardPane" fitToWidth="true" hbarPolicy="NEVER">
                    <content>
                        <VBox spacing="16" styleClass="dashboard-content">
                            <VBox fx:id="notificationList"
                                  spacing="8"
                                  visible="false"
                                  managed="false"/>

                            <HBox spacing="16">
                                <VBox spacing="8" styleClass="hero-card" minWidth="0" HBox.hgrow="ALWAYS">
                                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="recommendation-heading">
                                        <Region styleClass="recommendation-marker"/>
                                        <Label text="Recommended worksheet" styleClass="section-eyebrow,recommendation-eyebrow"/>
                                    </HBox>
                                    <Label fx:id="recommendationTitleLabel"
                                           text="No recommendation yet"
                                           styleClass="dashboard-hero-title"
                                           wrapText="true"/>
                                    <Label fx:id="recommendationMetaLabel"
                                           text="Add a worksheet to begin your study record."
                                           styleClass="muted-text,recommendation-topic"
                                           wrapText="true"/>
                                    <HBox fx:id="recommendationVisualMeta"
                                          spacing="10"
                                          alignment="CENTER_LEFT"/>
                                    <FlowPane fx:id="recommendationReasonBox"
                                              hgap="8"
                                              vgap="6"
                                              styleClass="recommendation-statuses"
                                              visible="false"
                                              managed="false"/>

                                    <FlowPane hgap="10" vgap="8" styleClass="dashboard-actions">
                                        <Button text="Open recommendation"
                                                onAction="#handleOpenRecommendation"
                                                fx:id="openRecommendationButton"
                                                styleClass="primary-button"/>
                                        <Button text="Pick another"
                                                fx:id="pickAnotherButton"
                                                onAction="#handleRefresh"/>
                                    </FlowPane>
                                </VBox>

                                <VBox spacing="9" styleClass="stat-card,study-record" minWidth="240" prefWidth="270" maxWidth="270">
                                    <Label text="STUDY RECORD" styleClass="section-eyebrow"/>
                                    <Label text="Progress" styleClass="section-title"/>

                                    <HBox fx:id="rankRecordRow" alignment="CENTER_LEFT" styleClass="study-record-row">
                                        <Label text="Study habit" styleClass="study-record-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="rankLabel" text="Getting started" styleClass="study-record-value"/>
                                    </HBox>

                                    <VBox fx:id="xpRecordGroup" spacing="5" styleClass="study-record-group">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="XP" styleClass="study-record-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="xpLabel" text="0 XP" styleClass="study-record-value"/>
                                        </HBox>
                                        <ProgressBar fx:id="rankProgressBar" maxWidth="Infinity"/>
                                    </VBox>

                                    <HBox fx:id="streakRecordRow" alignment="CENTER_LEFT" styleClass="study-record-row">
                                        <Label text="Streak" styleClass="study-record-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="streakLabel" text="0 study sessions" styleClass="study-record-value"/>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" styleClass="study-record-row">
                                        <Label text="Mistakes" styleClass="study-record-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="mistakeCountLabel"
                                               text="0 unresolved"
                                               styleClass="study-record-value,study-record-success"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <VBox spacing="12" styleClass="dashboard-card,exam-calendar-card">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Exam Calendar" styleClass="section-title,exam-calendar-title"/>
                                        <Label fx:id="examCalendarMonthLabel"
                                               text="This month"
                                               styleClass="exam-calendar-month"/>
                                    </VBox>

                                    <Button text="&lt;"
                                            accessibleText="Previous month"
                                            onAction="#handlePreviousExamMonth"
                                            styleClass="calendar-nav-button"/>

                                    <Button text="Today"
                                            onAction="#handleCurrentExamMonth"
                                            styleClass="compact-button"/>

                                    <Button text="&gt;"
                                            accessibleText="Next month"
                                            onAction="#handleNextExamMonth"
                                            styleClass="calendar-nav-button"/>
                                </HBox>

                                <HBox spacing="14"
                                      alignment="TOP_LEFT"
                                      maxWidth="Infinity"
                                      styleClass="exam-calendar-layout">
                                    <VBox spacing="8"
                                          minWidth="0"
                                          HBox.hgrow="ALWAYS"
                                          maxWidth="Infinity"
                                          styleClass="exam-calendar-board">
                                        <GridPane fx:id="examCalendarGrid"
                                                  hgap="3"
                                                  vgap="3"
                                                  styleClass="exam-calendar-grid"/>
                                    </VBox>

                                    <VBox spacing="10"
                                          minWidth="230"
                                          prefWidth="270"
                                          maxWidth="270"
                                          styleClass="exam-calendar-agenda">
                                        <Label text="Scheduled exams" styleClass="card-title"/>
                                        <VBox fx:id="examCalendarEvents" spacing="8"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <HBox spacing="18">
                                <VBox spacing="12" styleClass="dashboard-card" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Topics to revisit" styleClass="section-title"/>
                                    <VBox fx:id="weakTopicsList" spacing="10"/>
                                </VBox>

                                <VBox spacing="12" styleClass="dashboard-card" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Recent attempts" styleClass="section-title"/>
                                    <VBox fx:id="recentAttemptsList" spacing="10"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="statusLabel" text="" styleClass="status-text"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
