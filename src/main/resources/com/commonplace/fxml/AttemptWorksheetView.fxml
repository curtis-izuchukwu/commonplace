<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.commonplace.ui.controller.AttemptWorksheetController"
      spacing="14"
      styleClass="app-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="worksheetTitleLabel" text="Attempt Worksheet" styleClass="app-title"/>
            <Label fx:id="worksheetMetaLabel"
                   text="Worksheet details"
                   styleClass="app-subtitle"
                   wrapText="true"/>
        </VBox>

        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="danger-button"/>
    </HBox>

    <Label text="Answer each question before revealing the mark scheme."
           wrapText="true"
           styleClass="muted-text"/>

    <Separator/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="questionsContainer" spacing="14"/>
        </content>
    </ScrollPane>

    <Separator/>

    <HBox spacing="10">
        <Button text="Submit Attempt"
                onAction="#handleSubmitAttempt"
                styleClass="primary-button"/>
        <Label fx:id="scorePreviewLabel"
               text="Score: not submitted"
               styleClass="status-text"/>
    </HBox>

    <Label fx:id="statusLabel" text="" styleClass="status-text"/>
</VBox>
