<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.commonplace.ui.controller.ImportWorksheetController"
           fx:id="importRoot"
           styleClass="app-root">

    <VBox spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <HBox spacing="12">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Import Worksheet (Beta)" styleClass="app-title"/>
                <Label text="Extract a local PDF into an editable draft before saving."
                       styleClass="app-subtitle"
                       wrapText="true"/>
            </VBox>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>

        <VBox spacing="12" styleClass="settings-panel">
            <Label text="PDF Source" styleClass="section-title"/>
            <HBox spacing="10">
                <TextField fx:id="pdfPathField"
                           promptText="Choose a PDF file"
                           editable="false"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Browse"
                        onAction="#handleChoosePdf"/>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Module" styleClass="small-label"/>
                    <ComboBox fx:id="moduleCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Topic" styleClass="small-label"/>
                    <ComboBox fx:id="topicCombo" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <Button fx:id="importButton"
                    text="Import from PDF"
                    onAction="#handleImportPdf"
                    styleClass="primary-button"/>

            <Button fx:id="reviewDraftButton"
                    text="Review Draft"
                    onAction="#handleShowReview"
                    visible="false"
                    managed="false"/>
        </VBox>

        <Label fx:id="statusLabel"
               text=""
               styleClass="status-text"
               wrapText="true"/>
    </VBox>

    <StackPane fx:id="reviewOverlay"
               visible="false"
               managed="false">
        <styleClass>
            <String fx:value="overlay-scrim"/>
            <String fx:value="import-review-scrim"/>
        </styleClass>

        <VBox fx:id="reviewPanel"
              spacing="14"
              maxWidth="840"
              maxHeight="700">
            <styleClass>
                <String fx:value="app-root"/>
                <String fx:value="import-review-panel"/>
            </styleClass>

            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>

            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Review Imported Worksheet" styleClass="app-title"/>
                    <Label text="Edit the extracted worksheet before adding it to your topic."
                           styleClass="app-subtitle"
                           wrapText="true"/>
                </VBox>
                <Button text="Back"
                        onAction="#handleCloseReview"/>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Worksheet title" styleClass="small-label"/>
                    <TextField fx:id="titleField"
                               promptText="Worksheet title"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Difficulty" styleClass="small-label"/>
                    <ComboBox fx:id="difficultyCombo" prefWidth="170"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Priority" styleClass="small-label"/>
                    <ComboBox fx:id="importanceCombo" prefWidth="170"/>
                </VBox>
            </HBox>

            <VBox spacing="6" styleClass="notification-card">
                <Label text="Import notes" styleClass="card-title"/>
                <VBox fx:id="issuesList" spacing="4"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Review questions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Button text="Add Question"
                        onAction="#handleAddQuestion"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="12">
                        <VBox fx:id="questionsContainer" spacing="12"/>

                        <VBox spacing="8" styleClass="notification-card">
                            <Label text="Unattached images" styleClass="card-title"/>
                            <Label text="Attach diagrams to a question or discard them before saving."
                                   styleClass="muted-text"
                                   wrapText="true"/>
                            <VBox fx:id="unattachedImagesContainer" spacing="10"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

            <Label fx:id="reviewStatusLabel"
                   text=""
                   styleClass="status-text"
                   wrapText="true"/>

            <HBox spacing="10">
                <Button fx:id="saveButton"
                        text="Save Imported Worksheet"
                        onAction="#handleSaveImportedWorksheet"
                        styleClass="primary-button"/>
                <Button text="Back"
                        onAction="#handleCloseReview"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
