<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pararepilot.ui.controller.WorksheetCreateController"
      spacing="14"
      styleClass="app-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Create Worksheet" styleClass="app-title"/>
    <Label fx:id="parentTopicLabel"
           text="Parent topic"
           styleClass="app-subtitle"
           wrapText="true"/>

    <Separator/>

    <TextField fx:id="titleField" promptText="Worksheet title, e.g. BST Traversal Practice"/>

    <TextArea fx:id="descriptionArea"
              promptText="Description"
              prefRowCount="3"
              wrapText="true"/>

    <HBox spacing="10">
        <ComboBox fx:id="difficultyCombo" promptText="Difficulty"/>
        <ComboBox fx:id="importanceCombo" promptText="Importance"/>
    </HBox>

    <Separator/>

    <HBox spacing="12">
        <Label text="Questions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
        <Button text="Add Question"
                onAction="#handleAddQuestion"
                styleClass="primary-button"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="questionsContainer" spacing="12"/>
        </content>
    </ScrollPane>

    <HBox spacing="10">
        <Button text="Save Worksheet"
                onAction="#handleSaveWorksheet"
                styleClass="primary-button"/>
        <Button text="Cancel"
                onAction="#handleCancel"/>
    </HBox>

    <Label fx:id="statusLabel" text="" styleClass="status-text"/>
</VBox>