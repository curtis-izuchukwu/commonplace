<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:id="settingsRoot"
      fx:controller="com.pararepilot.ui.controller.SettingsController"
      spacing="14"
      styleClass="app-root,settings-root">

    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>

    <VBox spacing="4">
        <Label text="Settings" styleClass="app-title"/>
        <Label text="Account-specific controls for study flow, appearance, reminders, data, and accessibility."
               styleClass="app-subtitle"
               wrapText="true"/>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <GridPane hgap="18" vgap="14">
                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Account" styleClass="section-title"/>
                    <HBox spacing="10">
                        <Button text="Change Password" onAction="#handleChangePassword"/>
                        <Button text="Switch Account" onAction="#handleSwitchAccount"/>
                        <Button text="Log Out" onAction="#handleLogOut"/>
                    </HBox>
                    <Button text="Delete Account Later" disable="true"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Appearance" styleClass="section-title"/>
                    <Label text="Theme" styleClass="small-label"/>
                    <ComboBox fx:id="themeComboBox" maxWidth="Infinity" styleClass="appearance-combo"/>
                    <Label text="Accent" styleClass="small-label"/>
                    <ComboBox fx:id="accentComboBox" maxWidth="Infinity" styleClass="appearance-combo,accent-combo"/>
                    <CheckBox fx:id="compactLayoutCheckBox" text="Compact layout"/>
                    <Label text="Font size" styleClass="small-label"/>
                    <ComboBox fx:id="fontSizeComboBox" maxWidth="Infinity"/>
                    <CheckBox fx:id="reduceMotionCheckBox"
                              text="Reduce animations"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Study Preferences" styleClass="section-title"/>
                    <Label text="Daily worksheet time" styleClass="small-label"/>
                    <TextField fx:id="reminderTimeField" promptText="18:00"/>
                    <Label text="Daily worksheet count" styleClass="small-label"/>
                    <Spinner fx:id="dailyGoalSpinner" editable="true"/>
                    <Label text="Worksheet interval days" styleClass="small-label"/>
                    <Spinner fx:id="intervalDaysSpinner" editable="true"/>
                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Min difficulty" styleClass="small-label"/>
                            <ComboBox fx:id="minDifficultyComboBox" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Max difficulty" styleClass="small-label"/>
                            <ComboBox fx:id="maxDifficultyComboBox" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Label text="Recommendation focus" styleClass="small-label"/>
                    <ComboBox fx:id="recommendationFocusComboBox" maxWidth="Infinity"/>
                    <CheckBox fx:id="includeResolvedMistakesCheckBox"
                              text="Include resolved mistakes in recommendations"/>
                    <Button text="Reset Today's Recommendation"
                            onAction="#handleResetRecommendation"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Notifications" styleClass="section-title"/>
                    <CheckBox fx:id="dailyReminderCheckBox" text="Daily study reminder"/>
                    <CheckBox fx:id="examReminderCheckBox" text="Exam countdown reminders"/>
                    <CheckBox fx:id="mistakeReminderCheckBox" text="Mistake review reminders"/>
                    <CheckBox fx:id="streakReminderCheckBox" text="Streak reminder"/>
                    <CheckBox fx:id="quietHoursCheckBox" text="Quiet hours"/>
                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Quiet start" styleClass="small-label"/>
                            <TextField fx:id="quietHoursStartField" promptText="22:00"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Quiet end" styleClass="small-label"/>
                            <TextField fx:id="quietHoursEndField" promptText="07:00"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Gamification" styleClass="section-title"/>
                    <CheckBox fx:id="showXpAndRankCheckBox" text="Show XP and rank"/>
                    <CheckBox fx:id="streakTrackingCheckBox" text="Enable streak tracking"/>
                    <CheckBox fx:id="completionCelebrationsCheckBox" text="Enable completion celebrations"/>
                    <Button text="Reset Gamification Progress"
                            onAction="#handleResetGamification"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Modules &amp; Data" styleClass="section-title"/>
                    <Label text="Default module priority" styleClass="small-label"/>
                    <ComboBox fx:id="defaultModulePriorityComboBox" maxWidth="Infinity"/>
                    <CheckBox fx:id="archiveCompletedModulesCheckBox"
                              text="Archive completed modules"/>
                    <HBox spacing="10">
                        <Button text="Export Data" onAction="#handleExportData"/>
                        <Button text="Import Backup" onAction="#handleImportBackup"/>
                    </HBox>
                    <Button text="Clear Local Data"
                            onAction="#handleClearLocalData"
                            styleClass="danger-button"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-panel" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Accessibility" styleClass="section-title"/>
                    <CheckBox fx:id="higherContrastCheckBox" text="Higher contrast"/>
                    <CheckBox fx:id="largerControlsCheckBox" text="Larger controls"/>
                </VBox>
            </GridPane>
        </content>
    </ScrollPane>

    <HBox spacing="10">
        <Button text="Save Settings"
                onAction="#handleSave"
                styleClass="primary-button"/>

        <Button text="Cancel"
                onAction="#handleCancel"/>
    </HBox>

    <Label fx:id="statusLabel"
           text=""
           wrapText="true"
           styleClass="status-text"/>
</VBox>
