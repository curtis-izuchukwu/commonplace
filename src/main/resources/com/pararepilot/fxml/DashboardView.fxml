<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.pararepilot.ui.controller.DashboardController"
           styleClass="app-root">

    <BorderPane>
        <top>
            <HBox spacing="12" styleClass="top-bar">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel"
                           text="Welcome Back"
                           styleClass="app-title"/>
                </VBox>

                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        onAction="#handleOpenDashboard"/>

                <Button text="Manage Modules"
                        fx:id="manageModulesButton"
                        onAction="#handleOpenModules"/>

                <Button text="Mistake Bank"
                        onAction="#handleOpenMistakeBank"/>

                <MenuButton fx:id="accountMenuButton"
                            text=""
                            styleClass="account-menu-button">
                    <items>
                        <MenuItem fx:id="accountNameItem" text="Signed in"/>
                        <MenuItem text="Settings" onAction="#handleOpenSettings"/>
                        <MenuItem text="Change Password" onAction="#handleChangePassword"/>
                        <MenuItem text="Switch Account" onAction="#handleSwitchAccount"/>
                    </items>
                </MenuButton>
            </HBox>
        </top>

        <center>
            <StackPane fx:id="contentHost">
                <ScrollPane fx:id="dashboardPane" fitToWidth="true">
                    <content>
                        <VBox spacing="18" styleClass="dashboard-content">
                            <VBox fx:id="notificationList"
                                  spacing="8"
                                  visible="false"
                                  managed="false"/>

                            <HBox spacing="18">
                                <VBox spacing="7" styleClass="hero-card" HBox.hgrow="ALWAYS">
                                    <Label text="Recommended Worksheet" styleClass="section-title"/>
                                    <Label fx:id="recommendationTitleLabel"
                                           text="No recommendation yet"
                                           styleClass="dashboard-hero-title"
                                           wrapText="true"/>
                                    <Label fx:id="recommendationMetaLabel"
                                           text="Create worksheets to unlock adaptive recommendations."
                                           styleClass="muted-text"
                                           wrapText="true"/>
                                    <HBox fx:id="recommendationVisualMeta"
                                          spacing="10"
                                          alignment="CENTER_LEFT"/>
                                    <Label fx:id="recommendationReasonLabel"
                                           text=""
                                           styleClass="muted-text"
                                           visible="false"
                                           managed="false"
                                           wrapText="true"/>

                                    <HBox spacing="10">
                                        <Button text="Open Recommendation"
                                                onAction="#handleOpenRecommendation"
                                                fx:id="openRecommendationButton"
                                                styleClass="primary-button"/>
                                        <Button text="Pick Another"
                                                fx:id="pickAnotherButton"
                                                onAction="#handleRefresh"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="12" styleClass="stat-card" prefWidth="300">
                                    <Label text="Progress" styleClass="section-title"/>

                                    <Label fx:id="rankLabel"
                                           text="Rank: Novice"
                                           styleClass="dashboard-stat-main"/>

                                    <Label fx:id="xpLabel"
                                           text="0 XP"
                                           styleClass="muted-text"/>

                                    <ProgressBar fx:id="rankProgressBar" prefWidth="260"/>

                                    <Label fx:id="streakLabel"
                                           text="0 day streak"
                                           styleClass="dashboard-stat-main"/>

                                    <Label fx:id="mistakeCountLabel"
                                           text="0 unresolved mistakes"
                                           styleClass="muted-text"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="18">
                                <VBox spacing="12" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                                    <Label text="Weakest Topics" styleClass="section-title"/>
                                    <VBox fx:id="weakTopicsList" spacing="10"/>
                                </VBox>

                                <VBox spacing="12" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                                    <Label text="Recent Attempts" styleClass="section-title"/>
                                    <VBox fx:id="recentAttemptsList" spacing="10"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="statusLabel" text="" styleClass="status-text"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
