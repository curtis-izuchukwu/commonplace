<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pararepilot.ui.controller.ReflectionController"
      spacing="14"
      styleClass="app-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Reflection" styleClass="app-title"/>
        <Label fx:id="summaryLabel"
               text="Score summary"
               styleClass="app-subtitle"
               wrapText="true"/>
    </VBox>

    <Separator/>

    <Label text="How confident do you feel now?" styleClass="section-title"/>
    <Label text="Confidence" styleClass="small-label"/>
    <ComboBox fx:id="confidenceCombo"
              promptText="Confidence"
              maxWidth="Infinity"/>

    <Label text="Main weakness" styleClass="section-title"/>
    <TextArea fx:id="mainWeaknessArea"
              promptText="Example: I forgot the deletion cases."
              prefRowCount="3"
              wrapText="true"/>

    <Label text="Next action" styleClass="section-title"/>
    <TextArea fx:id="nextActionArea"
              promptText="Example: Revisit lecture notes on inorder successor/predecessor."
              prefRowCount="3"
              wrapText="true"/>

    <Label text="General notes" styleClass="section-title"/>
    <TextArea fx:id="reflectionNotesArea"
              promptText="Any extra thoughts about this attempt."
              prefRowCount="4"
              wrapText="true"/>

    <HBox spacing="10">
        <Button text="Save Reflection"
                onAction="#handleSaveReflection"
                styleClass="primary-button"/>

        <Button text="Skip for now"
                onAction="#handleSkipReflection"/>

        <Label fx:id="statusLabel"
               text=""
               styleClass="status-text"
               HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
